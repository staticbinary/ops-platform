# Ops Platform Environment Configuration
# Copy this file to .env before starting the platform.
#
# cp .env.example .env

# -------------------------------------------------------------------
# Ports
# -------------------------------------------------------------------

REVERSE_PROXY_PORT=8000
ASSET_SERVICE_PORT=8001
AUTH_SERVICE_PORT=8002

# -------------------------------------------------------------------
# Shared JWT Configuration
# -------------------------------------------------------------------

JWT_SECRET_KEY=replace-with-generated-secret
JWT_ALGORITHM=HS256

# -------------------------------------------------------------------
# Asset Service
# -------------------------------------------------------------------

ASSET_SERVICE_NAME=asset-service
ASSET_SERVICE_ENVIRONMENT=development

# -------------------------------------------------------------------
# Auth Service
# -------------------------------------------------------------------
# No service-specific environment variables currently required.

# -------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------

POSTGRES_DB=ops_platform
POSTGRES_USER=ops_user
POSTGRES_PASSWORD=replace-with-postgres-password

# -------------------------------------------------------------------
# Grafana SMTP
# -------------------------------------------------------------------
# Optional. Used for alert notifications.
# Do not commit real SMTP credentials.

GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=replace-with-smtp-user
GF_SMTP_PASSWORD=replace-with-smtp-password
GF_SMTP_FROM_ADDRESS=ops-platform@example.com
GF_SMTP_FROM_NAME=Ops Platform Grafana
GF_SMTP_SKIP_VERIFY=false
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
