      "targets": [
        {
          "expr": "sum(increase(auth_login_failure_total[5m])) + sum(increase(invalid_token_total[5m])) + sum(increase(permission_denied_total[5m])) + sum(increase(rate_limit_exceeded_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
